+// advertisesHead reports whether the target advertises HEAD. A server advertises HEAD only
+// when it resolves, so its absence from a non-empty advertisement means HEAD dangles: the
+// target has refs but no default branch, which is the state this warning is about.
+func advertisesHead(refs []*plumbing.Reference) bool {
+	for _, ref := range refs {
+		if ref.Name() == plumbing.HEAD {
+			return true
+		}
+	}
+	return false
+}
